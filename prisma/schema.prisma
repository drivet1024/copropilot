// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MASTER_USER
  CONDO_MANAGER
  BOARD_MEMBER
  OWNER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum PaymentMethod {
  CHEQUE
  BANK_TRANSFER
  PRE_AUTHORIZED
  CASH
  OTHER
}

enum UnitOccupancyStatus {
  OWNER_OCCUPIED
  NON_OWNER_OCCUPIED
  RENTED
  VACANT
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  condos           Condo[]
  condoFeePayments CondoFeePayment[]
  users            User[]
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String?
  name           String?
  role           UserRole   @default(VIEWER)
  status         UserStatus @default(ACTIVE)
  organizationId String?
  condoId        String?
  unitId         String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastLoginAt    DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id])
  condo        Condo?        @relation(fields: [condoId], references: [id])
  unit         Unit?         @relation(fields: [unitId], references: [id])

  auditLogs               AuditLog[]
  createdCondoFeePayments CondoFeePayment[] @relation("CreatedCondoFeePayments")
}

model Condo {
  id                String    @id @default(cuid())
  name              String
  address           String?
  fiscalYearEndDate DateTime?
  organizationId    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  buildings        Building[]
  documents        Document[]
  maintenance      MaintenanceTask[]
  users            User[]
  vendors          Vendor[]
  condoFeePayments CondoFeePayment[]
}

model Building {
  id        String   @id @default(cuid())
  name      String
  address   String?
  condoId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  condo Condo  @relation(fields: [condoId], references: [id])
  units Unit[]
}

model Unit {
  id         String   @id @default(cuid())
  number     String
  floor      String?
  buildingId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ownerName            String?
  email                String?
  phone                String?
  mobile               String?
  squareFeet           Int?
  roomCount            String?
  hasFireplace         Boolean   @default(false)
  bathroomCount        Float?
  insuranceRenewalDate DateTime?
  waterHeaterDate      DateTime?
  hasAirConditioning   Boolean   @default(false)
  monthlyCondoFee      Decimal?  @db.Decimal(10, 2)
  sharePercentage      Decimal?  @db.Decimal(6, 3)
  parkingSpace         String?
  storageLocker        String?
  status               UnitOccupancyStatus?
  notes                String?
  deletedAt            DateTime?

  building              Building               @relation(fields: [buildingId], references: [id])
  condoFeePayments      CondoFeePayment[]
  insuranceReminderLogs InsuranceReminderLog[]
  users                 User[]

  @@index([buildingId])
  @@index([number])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Document {
  id        String   @id @default(cuid())
  title     String
  type      String?
  url       String?
  condoId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  condo Condo @relation(fields: [condoId], references: [id])
}

model SmsTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  type      String   @default("INSURANCE_RENEWAL")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// TODO: En production, stocker les secrets Twilio dans des variables d'environnement ou les chiffrer.
model TwilioConfig {
  id                  String   @id @default(cuid())
  accountSid          String?
  authToken           String?
  messagingServiceSid String?
  fromPhoneNumber     String?
  isEnabled           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model InsuranceReminderLog {
  id                   String   @id @default(cuid())
  unitId               String
  insuranceRenewalDate DateTime
  reminderType         String   @default("SMS_4_WEEKS_BEFORE")
  sentTo               String?
  messageBody          String
  status               String   @default("SENT")
  errorMessage         String?
  sentAt               DateTime @default(now())
  createdAt            DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, insuranceRenewalDate, reminderType])
}

model MaintenanceTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  condoId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  condo Condo @relation(fields: [condoId], references: [id])
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  category  String?
  email     String?
  phone     String?
  condoId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  condo Condo @relation(fields: [condoId], references: [id])
}

model CondoFeePayment {
  id                 String        @id @default(cuid())
  tenantId           String
  condoCorporationId String
  unitId             String
  amount             Decimal       @db.Decimal(10, 2)
  paymentDate        DateTime
  paymentMethod      PaymentMethod
  chequeNumber       String?
  notes              String?
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant           Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  condoCorporation Condo        @relation(fields: [condoCorporationId], references: [id], onDelete: Cascade)
  unit             Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy        User?        @relation("CreatedCondoFeePayments", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([condoCorporationId])
  @@index([unitId])
  @@index([paymentDate])
  @@index([paymentMethod])
}
